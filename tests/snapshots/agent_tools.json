    "read": [
      {
        "description": "Every host in the fleet with headline vitals (the hub first): online state, CPU, RAM and every filesystem's use %. Start here; one call covers the whole fleet.",
        "host_scope": "fleet",
        "kind": "read",
        "name": "list_hosts",
        "parameters": {
          "additionalProperties": false,
          "properties": {},
          "required": [],
          "type": "object"
        }
      },
      {
        "description": "Full System/Network/Security inventory of one host, including its Docker containers and systemd services. Large: use it when one host needs a closer look.",
        "host_scope": "arg",
        "kind": "read",
        "name": "get_host",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "description": "Host name from list_hosts, or \"local\" for the hub itself.",
              "maxLength": 128,
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        }
      },
      {
        "description": "The hub's live overview: GPU, host, problem containers and failed services.",
        "host_scope": "hub",
        "kind": "read",
        "name": "get_snapshot",
        "parameters": {
          "additionalProperties": false,
          "properties": {},
          "required": [],
          "type": "object"
        }
      },
      {
        "description": "Every Docker container with state, health, RAM, VRAM and disk. `host` picks the machine (default: the hub).",
        "host_scope": "host_opt",
        "kind": "read",
        "name": "get_containers",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "host": {
              "default": "local",
              "description": "Host name from list_hosts, or \"local\" for the hub itself.",
              "maxLength": 128,
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      {
        "description": "Every systemd unit with state, ports and RAM. `host` picks the machine (default: the hub).",
        "host_scope": "host_opt",
        "kind": "read",
        "name": "get_services",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "host": {
              "default": "local",
              "description": "Host name from list_hosts, or \"local\" for the hub itself.",
              "maxLength": 128,
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      {
        "description": "RAM breakdown per service and process on the hub over a time window.",
        "host_scope": "hub",
        "kind": "read",
        "name": "get_memory",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "range": {
              "default": "6h",
              "description": "Time window.",
              "enum": [
                "1h",
                "6h",
                "24h",
                "7d",
                "30d"
              ],
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      {
        "description": "GPU utilisation, VRAM per model and who drives it, on the hub.",
        "host_scope": "hub",
        "kind": "read",
        "name": "get_gpu",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "range": {
              "default": "6h",
              "description": "Time window.",
              "enum": [
                "1h",
                "6h",
                "24h",
                "7d",
                "30d"
              ],
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      {
        "description": "Charted time series of the hub (GPU, CPU, RAM, load, temperatures).",
        "host_scope": "hub",
        "kind": "read",
        "name": "get_history",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "range": {
              "default": "6h",
              "description": "Time window.",
              "enum": [
                "1h",
                "6h",
                "24h",
                "7d",
                "30d"
              ],
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      {
        "description": "Folder-size treemap of a path on the hub (largest folders first). Slow and deep: only to find what fills a disk the overview showed nearly full, or when asked.",
        "host_scope": "hub",
        "kind": "read",
        "name": "scan_disk",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "default": "/",
              "maxLength": 512,
              "type": "string"
            },
            "rescan": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      {
        "description": "Loaded model servers, their VRAM and callers.",
        "host_scope": "fleet",
        "kind": "read",
        "name": "get_ai_models",
        "parameters": {
          "additionalProperties": false,
          "properties": {
            "range": {
              "default": "6h",
              "description": "Time window.",
              "enum": [
                "1h",
                "6h",
