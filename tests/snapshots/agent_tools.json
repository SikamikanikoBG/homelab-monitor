  "body": {
    "actions": [
      {
        "default_rule": "deny",
        "id": "container.start",
        "idempotent": true,
        "params": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "type": "object"
        },
        "preview": {
          "linux": "docker start -- {name}",
          "local": "POST /containers/{name}/start (Docker API)",
          "windows": "docker start -- {name}"
        },
        "probe": false,
        "requires": [
          "docker"
        ],
        "risk": "low",
        "sudo": false,
        "target": {
          "kind": "container",
          "param": "name"
        },
        "targets": [
          "local",
          "linux",
          "windows"
        ],
        "title": "Start a container",
        "unattended": "policy"
      },
