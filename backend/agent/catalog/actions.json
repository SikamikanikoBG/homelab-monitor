{
  "_doc": "The agent's only way to change anything: named, parameterised actions. Each argv element is a literal or exactly one {param}; an integer or enum param may also sit inside a literal (\"--vacuum-time={days}d\"). Commands stay within what POSIX and BusyBox tools accept, so they also run on minimal hosts. 'exit_codes' lists exit codes that are answers, not failures, with what they mean. Params are validated against their schema and quoted (shlex for POSIX, single quotes for PowerShell). risk 'none' = a read-only probe. Every rule defaults to deny until the owner ticks it. 'unattended': 'never' caps an action at Ask with no unlock. 'sudo': true actions run as `sudo -n` and are capped at Ask. Not in v1: reboot, volume removal, file deletion, any shell.",
  "version": 1,
  "actions": [
    {"id": "container.start", "title": "Start a container", "risk": "low", "idempotent": true,
     "target": {"param": "name", "kind": "container"}, "requires": ["docker"], "pre": ["container_exists"],
     "params": {"type": "object", "additionalProperties": false, "required": ["name"],
                "properties": {"name": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"}}},
     "local": {"via": "docker_api", "method": "POST", "path": "/containers/{name}/start"},
     "linux": {"via": "ssh", "argv": ["docker", "start", "--", "{name}"]},
     "windows": {"via": "ps", "argv": ["docker", "start", "--", "{name}"]},
     "timeout_s": 90},

    {"id": "container.restart", "title": "Restart a container", "risk": "low", "idempotent": true,
     "target": {"param": "name", "kind": "container"}, "requires": ["docker"], "pre": ["container_exists"],
     "params": {"type": "object", "additionalProperties": false, "required": ["name"],
                "properties": {"name": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"}}},
     "local": {"via": "docker_api", "method": "POST", "path": "/containers/{name}/restart"},
     "linux": {"via": "ssh", "argv": ["docker", "restart", "--", "{name}"]},
     "windows": {"via": "ps", "argv": ["docker", "restart", "--", "{name}"]},
     "timeout_s": 120},

    {"id": "container.stop", "title": "Stop a container", "risk": "medium", "idempotent": true,
     "target": {"param": "name", "kind": "container"}, "requires": ["docker"], "pre": ["container_exists"],
     "params": {"type": "object", "additionalProperties": false, "required": ["name"],
                "properties": {"name": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"}}},
     "local": {"via": "docker_api", "method": "POST", "path": "/containers/{name}/stop"},
     "linux": {"via": "ssh", "argv": ["docker", "stop", "--", "{name}"]},
     "windows": {"via": "ps", "argv": ["docker", "stop", "--", "{name}"]},
     "timeout_s": 120},

    {"id": "container.set_restart_policy", "title": "Change a container's restart policy", "risk": "low",
     "idempotent": true, "target": {"param": "name", "kind": "container"}, "requires": ["docker"],
     "pre": ["container_exists"],
     "params": {"type": "object", "additionalProperties": false, "required": ["name", "policy"],
                "properties": {"name": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"},
                               "policy": {"type": "string", "enum": ["no", "on-failure", "unless-stopped", "always"]}}},
     "local": {"via": "docker_api", "method": "POST", "path": "/containers/{name}/update",
               "body": {"RestartPolicy": {"Name": "{policy}"}}},
     "linux": {"via": "ssh", "argv": ["docker", "update", "--restart", "{policy}", "--", "{name}"]},
     "windows": {"via": "ps", "argv": ["docker", "update", "--restart", "{policy}", "--", "{name}"]},
     "timeout_s": 60},

    {"id": "service.start", "title": "Start a service", "risk": "medium", "idempotent": true, "sudo": true,
     "target": {"param": "unit", "kind": "service"}, "requires": ["services"], "pre": ["service_exists"],
     "params": {"type": "object", "additionalProperties": false, "required": ["unit"],
                "properties": {"unit": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]{0,254}$"}}},
     "local": {"via": "systemd", "action": "start"},
     "linux": {"via": "ssh", "argv": ["sudo", "-n", "systemctl", "start", "--", "{unit}"]},
     "windows": {"via": "ps", "argv": ["Start-Service", "-Name", "{unit}"]},
     "timeout_s": 120},

    {"id": "service.restart", "title": "Restart a service", "risk": "medium", "idempotent": true, "sudo": true,
     "target": {"param": "unit", "kind": "service"}, "requires": ["services"], "pre": ["service_exists"],
     "params": {"type": "object", "additionalProperties": false, "required": ["unit"],
                "properties": {"unit": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:-]{0,254}$"}}},
     "local": {"via": "systemd", "action": "restart"},
     "linux": {"via": "ssh", "argv": ["sudo", "-n", "systemctl", "restart", "--", "{unit}"]},
     "windows": {"via": "ps", "argv": ["Restart-Service", "-Force", "-Name", "{unit}"]},
     "timeout_s": 120},

    {"id": "docker.prune_dangling_images", "title": "Remove dangling (untagged) images", "risk": "low",
     "idempotent": true, "target": {"kind": "host"}, "requires": ["docker"],
     "params": {"type": "object", "additionalProperties": false, "properties": {}},
     "local": {"via": "docker_api", "method": "POST", "path": "/images/prune?filters=%7B%22dangling%22%3A%5B%22true%22%5D%7D"},
     "linux": {"via": "ssh", "argv": ["docker", "image", "prune", "--force"]},
     "windows": {"via": "ps", "argv": ["docker", "image", "prune", "--force"]},
     "timeout_s": 300},

    {"id": "docker.prune_build_cache", "title": "Remove the Docker build cache", "risk": "low", "idempotent": true,
     "target": {"kind": "host"}, "requires": ["docker"],
     "params": {"type": "object", "additionalProperties": false, "properties": {}},
     "local": {"via": "docker_api", "method": "POST", "path": "/build/prune"},
     "linux": {"via": "ssh", "argv": ["docker", "builder", "prune", "--force"]},
     "windows": {"via": "ps", "argv": ["docker", "builder", "prune", "--force"]},
     "timeout_s": 300},

    {"id": "docker.prune_stopped_containers", "title": "Remove stopped containers older than N hours",
     "risk": "medium", "idempotent": true, "target": {"kind": "host"}, "requires": ["docker"],
     "params": {"type": "object", "additionalProperties": false, "required": ["older_than_h"],
                "properties": {"older_than_h": {"type": "integer", "minimum": 1, "maximum": 8760}}},
     "local": {"via": "docker_api", "method": "POST",
               "path": "/containers/prune?filters=%7B%22until%22%3A%5B%22{older_than_h}h%22%5D%7D"},
     "linux": {"via": "ssh", "argv": ["docker", "container", "prune", "--force", "--filter", "until={older_than_h}h"]},
     "windows": {"via": "ps", "argv": ["docker", "container", "prune", "--force", "--filter", "until={older_than_h}h"]},
     "timeout_s": 300},

    {"id": "journal.vacuum", "title": "Shrink the systemd journal to the last N days", "risk": "medium",
     "idempotent": true, "sudo": true, "target": {"kind": "host"}, "requires": ["systemd", "linux"],
     "params": {"type": "object", "additionalProperties": false, "required": ["days"],
                "properties": {"days": {"type": "integer", "minimum": 1, "maximum": 365}}},
     "linux": {"via": "ssh", "argv": ["sudo", "-n", "journalctl", "--vacuum-time={days}d"]},
     "timeout_s": 300},

    {"id": "ollama.unload_model", "title": "Unload an Ollama model from memory", "risk": "low", "idempotent": true,
     "target": {"param": "model", "kind": "model"}, "requires": ["ollama"],
     "params": {"type": "object", "additionalProperties": false, "required": ["model"],
                "properties": {"model": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$"}}},
     "local": {"via": "ollama_api", "method": "POST", "path": "/api/generate", "body": {"model": "{model}", "keep_alive": 0}},
     "linux": {"via": "ssh", "argv": ["ollama", "stop", "{model}"]},
     "windows": {"via": "ps", "argv": ["ollama", "stop", "{model}"]},
     "timeout_s": 60},

    {"id": "ollama.remove_model", "title": "Delete an Ollama model from disk", "risk": "high", "idempotent": false,
     "unattended": "never", "bind": "model_digest", "target": {"param": "model", "kind": "model"},
     "requires": ["ollama"], "pre": ["model_installed", "model_not_loaded"],
     "params": {"type": "object", "additionalProperties": false, "required": ["model"],
                "properties": {"model": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$"}}},
     "local": {"via": "ollama_api", "method": "DELETE", "path": "/api/delete", "body": {"model": "{model}"}},
     "linux": {"via": "ssh", "argv": ["ollama", "rm", "{model}"]},
     "windows": {"via": "ps", "argv": ["ollama", "rm", "{model}"]},
     "timeout_s": 120},

    {"id": "docker.system_df", "title": "Docker disk usage", "risk": "none", "requires": ["docker"],
     "target": {"kind": "host"},
     "params": {"type": "object", "additionalProperties": false, "properties": {}},
     "local": {"via": "docker_api", "method": "GET", "path": "/system/df"},
     "linux": {"via": "ssh", "argv": ["docker", "system", "df"]},
     "windows": {"via": "ps", "argv": ["docker", "system", "df"]},
     "timeout_s": 60},

    {"id": "docker.list_dangling", "title": "List dangling images", "risk": "none", "requires": ["docker"],
     "target": {"kind": "host"},
     "params": {"type": "object", "additionalProperties": false, "properties": {}},
     "local": {"via": "docker_api", "method": "GET", "path": "/images/json?filters=%7B%22dangling%22%3A%5B%22true%22%5D%7D"},
     "linux": {"via": "ssh", "argv": ["docker", "images", "--filter", "dangling=true"]},
     "windows": {"via": "ps", "argv": ["docker", "images", "--filter", "dangling=true"]},
     "timeout_s": 60},

    {"id": "host.disk_usage", "title": "Disk usage per filesystem", "risk": "none", "requires": ["linux"],
     "target": {"kind": "host"},
     "params": {"type": "object", "additionalProperties": false, "properties": {}},
     "linux": {"via": "ssh", "argv": ["df", "-hP"]},
     "windows": {"via": "ps", "argv": ["Get-PSDrive", "-PSProvider", "FileSystem"]},
     "timeout_s": 30},

    {"id": "journal.disk_usage", "title": "Journal size", "risk": "none", "requires": ["systemd", "linux"],
     "target": {"kind": "host"},
     "params": {"type": "object", "additionalProperties": false, "properties": {}},
     "linux": {"via": "ssh", "argv": ["journalctl", "--disk-usage"]},
     "timeout_s": 30},

    {"id": "updates.list", "title": "Pending package updates (apt)", "risk": "none", "requires": ["apt"],
     "target": {"kind": "host"},
     "params": {"type": "object", "additionalProperties": false, "properties": {}},
     "linux": {"via": "ssh", "argv": ["apt", "list", "--upgradable"]},
     "timeout_s": 60},

    {"id": "host.reboot_required", "title": "Is a reboot pending", "risk": "none",
     "exit_codes": {"0": "A reboot is pending (/var/run/reboot-required exists).", "1": "No reboot is pending."},
     "requires": ["linux"], "target": {"kind": "host"},
     "params": {"type": "object", "additionalProperties": false, "properties": {}},
     "linux": {"via": "ssh", "argv": ["test", "-f", "/var/run/reboot-required"]},
     "timeout_s": 15},

    {"id": "ollama.list_models", "title": "Installed Ollama models", "risk": "none", "requires": ["ollama"],
     "target": {"kind": "host"},
     "params": {"type": "object", "additionalProperties": false, "properties": {}},
     "local": {"via": "ollama_api", "method": "GET", "path": "/api/tags"},
     "linux": {"via": "ssh", "argv": ["ollama", "list"]},
     "windows": {"via": "ps", "argv": ["ollama", "list"]},
     "timeout_s": 30},

    {"id": "gpu.kernel_errors_24h", "title": "Kernel errors of the last 24 h (GPU Xid errors show here)",
     "risk": "none", "requires": ["systemd", "linux"], "target": {"kind": "host"},
     "params": {"type": "object", "additionalProperties": false, "properties": {}},
     "linux": {"via": "ssh", "argv": ["journalctl", "-k", "--since", "-24h", "-p", "err", "--no-pager", "-q", "-n", "200"]},
     "timeout_s": 30},

    {"id": "files.list_older_than", "title": "Files older than N days under an allowed path, with their size in KB",
     "risk": "none", "requires": ["linux"], "pre": ["path_allowed"], "target": {"param": "path", "kind": "path"},
     "params": {"type": "object", "additionalProperties": false, "required": ["path", "days"],
                "properties": {"path": {"type": "string", "pattern": "^/[A-Za-z0-9._/-]{0,254}$"},
                               "days": {"type": "integer", "minimum": 1, "maximum": 3650}}},
     "linux": {"via": "ssh", "argv": ["find", "{path}", "-xdev", "-type", "f", "-mtime", "+{days}",
                                      "-exec", "du", "-k", "{}", "+"]},
     "timeout_s": 60},

    {"id": "files.changed_within", "title": "Files changed in the last N days under an allowed path (backup freshness)",
     "risk": "none", "requires": ["linux"], "pre": ["path_allowed"], "target": {"param": "path", "kind": "path"},
     "params": {"type": "object", "additionalProperties": false, "required": ["path", "days"],
                "properties": {"path": {"type": "string", "pattern": "^/[A-Za-z0-9._/-]{0,254}$"},
                               "days": {"type": "integer", "minimum": 1, "maximum": 365}}},
     "linux": {"via": "ssh", "argv": ["find", "{path}", "-maxdepth", "2", "-type", "f", "-mtime", "-{days}"]},
     "timeout_s": 60}
  ]
}
