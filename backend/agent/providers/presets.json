{
  "_doc": "Provider kinds, as data. Three code paths (adapter) cover them all. `discovery` lists the AI-server provider keys (backend/probes PROBES) a discovered server maps to. No prices here: they change too often to ship; set a price per model under Models & keys.",
  "presets": [
    {"id": "ollama", "label": "Ollama", "adapter": "ollama", "base_url": "", "auth": "none", "needs_key": false,
     "local": true, "discovery": ["ollama"], "default_port": 11434, "path": ""},
    {"id": "vllm", "label": "vLLM", "adapter": "openai_compat", "base_url": "", "auth": "bearer", "needs_key": false,
     "local": true, "discovery": ["vllm", "sglang"], "default_port": 8000, "path": "/v1",
     "extra_body": {"chat_template_kwargs": {"enable_thinking": false}}},
    {"id": "llamacpp", "label": "llama.cpp server", "adapter": "openai_compat", "base_url": "", "auth": "bearer",
     "needs_key": false, "local": true, "discovery": ["llama.cpp", "llama-server", "llamacpp"], "default_port": 8080, "path": "/v1"},
    {"id": "lmstudio", "label": "LM Studio", "adapter": "openai_compat", "base_url": "", "auth": "none",
     "needs_key": false, "local": true, "discovery": ["lmstudio", "lm-studio"], "default_port": 1234, "path": "/v1"},
    {"id": "localai", "label": "LocalAI", "adapter": "openai_compat", "base_url": "", "auth": "bearer",
     "needs_key": false, "local": true, "discovery": ["localai", "local-ai"], "default_port": 8080, "path": "/v1"},
    {"id": "openai_compatible", "label": "Any OpenAI-compatible URL", "adapter": "openai_compat", "base_url": "",
     "auth": "bearer", "needs_key": false, "local": true, "discovery": ["xinference", "mistral-rs", "text-generation-inference", "koboldcpp"], "path": "/v1"},
    {"id": "openai", "label": "OpenAI", "adapter": "openai_compat", "base_url": "https://api.openai.com/v1",
     "auth": "bearer", "needs_key": true, "local": false},
    {"id": "anthropic", "label": "Anthropic", "adapter": "anthropic", "base_url": "https://api.anthropic.com/v1",
     "auth": "x-api-key", "needs_key": true, "local": false},
    {"id": "gemini", "label": "Google Gemini", "adapter": "openai_compat",
     "base_url": "https://generativelanguage.googleapis.com/v1beta/openai", "auth": "bearer", "needs_key": true,
     "local": false, "experimental": true, "schema_strip": ["pattern", "additionalProperties"],
     "strip_models_prefix": true},
    {"id": "azure_openai", "label": "Azure OpenAI", "adapter": "openai_compat", "base_url": "",
     "auth": "api-key", "needs_key": true, "local": false, "api_version": "2024-10-21",
     "url_template": "{base}/openai/deployments/{deployment}/chat/completions?api-version={api_version}",
     "models_url_template": "{base}/openai/models?api-version={api_version}",
     "extra_fields": ["deployment", "api_version"]},
    {"id": "groq", "label": "Groq", "adapter": "openai_compat", "base_url": "https://api.groq.com/openai/v1",
     "auth": "bearer", "needs_key": true, "local": false},
    {"id": "mistral", "label": "Mistral", "adapter": "openai_compat", "base_url": "https://api.mistral.ai/v1",
     "auth": "bearer", "needs_key": true, "local": false},
    {"id": "deepseek", "label": "DeepSeek", "adapter": "openai_compat", "base_url": "https://api.deepseek.com/v1",
     "auth": "bearer", "needs_key": true, "local": false},
    {"id": "xai", "label": "xAI", "adapter": "openai_compat", "base_url": "https://api.x.ai/v1",
     "auth": "bearer", "needs_key": true, "local": false},
    {"id": "openrouter", "label": "OpenRouter", "adapter": "openai_compat", "base_url": "https://openrouter.ai/api/v1",
     "auth": "bearer", "needs_key": true, "local": false},
    {"id": "together", "label": "Together", "adapter": "openai_compat", "base_url": "https://api.together.xyz/v1",
     "auth": "bearer", "needs_key": true, "local": false}
  ]
}
